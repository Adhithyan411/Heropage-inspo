{
  "name": "stick-blush",
  "version": "0.1.0",
  "description": "Premium vector, holographic & chrome aesthetic sticker components for React",
  "author": {
    "name": "Adhithyan S",
    "url": "https://github.com/Adhithyan411"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Adhithyan411/Sticky.git"
  },
  "homepage": "https://github.com/Adhithyan411/Sticky#readme",
  "bugs": {
    "url": "https://github.com/Adhithyan411/Sticky/issues"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "keywords": [
    "react",
    "stickers",
    "sticker-pack",
    "stick-blush",
    "svg",
    "chrome",
    "metallic",
    "retro",
    "icons",
    "nextjs",
    "components"
  ],
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT"
}
